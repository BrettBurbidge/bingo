generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id               String            @id @db.Uuid
  email            String            @unique
  displayName      String?           @map("display_name")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitesSent      GameInvite[]      @relation("InvitedBy")
  invitesReceived  GameInvite[]      @relation("InvitedUser")
  gameParticipants GameParticipant[]
  gamesCreated     Game[]            @relation("GameMaster")
  gamesWon         Game[]            @relation("GameWinner")

  @@map("profiles")
}

model Game {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  gameMasterId      String             @map("game_master_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  status            GameStatus         @default(SETUP)
  winnerId          String?            @map("winner_id") @db.Uuid
  wordList          String[]           @default([]) @map("word_list")
  cardTypes         String[]           @default([]) @map("card_types") // "see" or "action" for each word
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(6)
  bonusSquare       Int?               @map("bonus_square") // Random square for first-to-mark bonus
  wildcardSquare    Int?               @map("wildcard_square") // Random wildcard square with 2x multiplier
  squareMarkHistory Json[]             @default([]) @map("square_mark_history") // Track who marked what when
  invites           GameInvite[]
  participants      GameParticipant[]
  guestParticipants GuestParticipant[]
  gameMaster        Profile            @relation("GameMaster", fields: [gameMasterId], references: [id], onDelete: Cascade)
  winner            Profile?           @relation("GameWinner", fields: [winnerId], references: [id])

  @@map("games")
}

model GameParticipant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId         String   @map("game_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  completedCells Int[]    @default([12]) @map("completed_cells")
  score          Int      @default(1)
  scoreBreakdown Json[]   @default([]) @map("score_breakdown") // Track how points were earned
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  boardData      String[] @default([]) @map("board_data")
  cardTypeData   String[] @default([]) @map("card_type_data") // "see" or "action" for each board position
  photoUrls      String[] @default([]) @map("photo_urls")
  hasWon         Boolean  @default(false) @map("has_won")
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user           Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@map("game_participants")
}

model GuestParticipant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId         String   @map("game_id") @db.Uuid
  email          String   @default("") @map("email")
  guestName      String?  @map("guest_name") // Optional display name
  completedCells Int[]    @default([12]) @map("completed_cells")
  score          Int      @default(1)
  scoreBreakdown Json[]   @default([]) @map("score_breakdown") // Track how points were earned
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  boardData      String[] @default([]) @map("board_data")
  cardTypeData   String[] @default([]) @map("card_type_data") // "see" or "action" for each board position
  photoUrls      String[] @default([]) @map("photo_urls")
  hasWon         Boolean  @default(false) @map("has_won")
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, email])
  @@map("guest_participants")
}

model GameInvite {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId    String           @map("game_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  invitedBy String           @map("invited_by") @db.Uuid
  status    GameInviteStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  email     String           @map("email")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  token     String           @unique @default(dbgenerated("gen_random_uuid()"))
  game      Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  inviter   Profile          @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  user      Profile?         @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, email])
  @@map("game_invites")
}

enum GameInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GameStatus {
  SETUP
  ACTIVE
  COMPLETED
}
